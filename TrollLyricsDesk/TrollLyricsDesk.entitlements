<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Groups：App 和 Widget 共用 group.com.hailong.TrollLyricsDesk
	     共享歌词状态（见 Lyrics/LyricStore.swift 的 groupID）。 -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.hailong.TrollLyricsDesk</string>
	</array>
	<!-- 跟随播放读正在放的歌要用的两项（LyricFever #94 里 Mx-Iris 对
	     mediaremoted 的逆向：读权限就看这两个；iOS 16.5 查不查，
	     只有真机说了算——读不到就留在自己的歌上，只记日志）。
	     注意：这两个不是标准 entitlements，Xcode 正常签名会报；
	     本项目走 TrollStore 路线：xcodebuild 不签名导出，
	     再用 ldid 按这个文件签名（见 .github/workflows/build.yml）。 -->
	<key>com.apple.mediaremote.now-playing-read-access</key>
	<true/>
	<key>com.apple.mediaremote.full-now-playing-read-access</key>
	<true/>
	<!-- v0.5 悬浮歌词 HUD 要用的 entitlements（全局窗口托管）：
	     主 App 和 HUD 子进程是同一个可执行文件，共用这一份。
	     Widget 的 entitlements 不动。 -->
	<key>com.apple.backboard.client</key>
	<true/>
	<key>com.apple.springboard.accessibility-window-hosting</key>
	<true/>
	<key>com.apple.assistivetouch.daemon</key>
	<true/>
	<key>com.apple.backboardd.launchapplications</key>
	<true/>
	<key>com.apple.springboard.launchapplications</key>
	<true/>
	<key>com.apple.private.security.no-sandbox</key>
	<true/>
	<key>platform-application</key>
	<true/>
	<key>get-task-allow</key>
	<true/>
	<key>task_for_pid-allow</key>
	<true/>
	<key>com.apple.private.security.task_for_pid-allow</key>
	<true/>
	<key>com.apple.security.exception.mach-lookup.global-name</key>
	<array>
		<string>com.apple.accessibility.AXSpringBoardServer</string>
	</array>
	<key>com.apple.security.exception.mach-register.global-name</key>
	<array>
		<string>com.trolllyricsdesk.v05.gsEvents</string>
	</array>
	<key>com.apple.security.exception.mach-register.local-name</key>
	<array>
		<string>com.trolllyricsdesk.v05</string>
	</array>
</dict>
</plist>
